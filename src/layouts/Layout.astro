---
export interface Props {
  title?: string;
  description?: string;
}
const { title = "News Diary", description = "A personal daily news digest." } =
  Astro.props;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — News Diary</title>

    <!-- Typefaces: Playfair Display for display, IBM Plex Mono for keywords -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;1,8..60,300&family=Patrick+Hand&family=Caveat:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --ink: #1c1814;
        --ink-soft: #6b6057;
        --paper: #f9f6f0;
        --cream: #f0ebe1;
        --red: #9b2020;
        --blue-margin: #b8c4d4;
        --pen: #1a3a6b;
        --rule: #ddd8ce;
        --rule-strong: #c8c2b4;
        --line-h: 1.75rem; /* ruled line height */
        --margin-w: 3.5rem; /* left margin column */
        --max-w: 720px;
      }

      html {
        /* desktop surface — slightly darker than the page itself */
        background: #e8e2d9;
        color: var(--ink);
        min-height: 100vh;
      }

      body {
        font-family: "Source Serif 4", Georgia, serif;
        font-size: 17px;
        line-height: var(--line-h);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 3rem 1.5rem 5rem;
      }

      /* ── The page sheet ───────────────────────────────── */
      .page {
        width: 100%;
        max-width: var(--max-w);
        background: var(--paper);
        border-radius: 4px;
        box-shadow:
          0 2px 8px rgba(0, 0, 0, 0.1),
          0 8px 32px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        /* left margin line */
        background-image: linear-gradient(
          to right,
          transparent var(--margin-w),
          var(--blue-margin) var(--margin-w),
          var(--blue-margin) calc(var(--margin-w) + 1.5px),
          transparent calc(var(--margin-w) + 1.5px)
        );
      }

      /* ── Main ─────────────────────────────────────────── */
      main {
        padding-left: calc(var(--margin-w) + 1px);
        /* no top padding — ruled lines start at top edge, content provides its own top margin */
        flex: 1;
        /* ruled lines drawn from the very top of main */
        /* ruled lines + dot mask: horizontal stripe every line-height,
           then a repeating gap pattern cuts the stripe into dots */
        background-image:
          repeating-linear-gradient(
            to right,
            var(--paper) 0,
            var(--paper) 1px,
            transparent 1px,
            transparent 2px
          ),
          repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent calc(var(--line-h) - 1px),
            var(--rule) calc(var(--line-h) - 1px),
            var(--rule) var(--line-h)
          );
        background-origin: border-box;
        background-position: 0 0;
      }

      /* ── Footer ───────────────────────────────────────── */
      footer {
        border-top: 1px solid var(--rule-strong);
        padding: var(--line-h) 2rem;
        font-family: "Caveat", cursive;
        font-size: 0.95rem;
        color: var(--ink-soft);
        padding-left: calc(var(--margin-w) + 1.5rem);
      }

      @media (max-width: 600px) {
        html {
          background: var(--paper);
        }

        body {
          padding: 0;
        }

        .page {
          background-image: none;
          box-shadow: none;
        }

        main {
          padding-left: 0.75rem;
        }

        footer {
          padding: var(--line-h) 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
