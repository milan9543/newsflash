---
import Layout from "../layouts/Layout.astro";
import NewsEntry from "../components/NewsEntry.astro";

export async function getStaticPaths() {
  const files = import.meta.glob("../../news/*.json", { eager: true });

  return Object.entries(files)
    .map(([path, data]) => {
      const date = path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1];
      if (!date) return null;
      return { params: { date }, props: { data } };
    })
    .filter(Boolean);
}

const { data } = Astro.props as { data: any };
const { date } = Astro.params;

const allFiles = import.meta.glob("../../news/*.json", { eager: true });
const allDates = Object.keys(allFiles)
  .map((p) => p.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1])
  .filter(Boolean)
  .sort() as string[];

const idx = allDates.indexOf(date!);
const prev = idx > 0 ? allDates[idx - 1] : null;
const next = idx < allDates.length - 1 ? allDates[idx + 1] : null;
---

<Layout title={date} description={`News digest for ${date}.`}>
  <NewsEntry data={data} />

  <nav
    class="font-hand mt-8 flex flex-row items-center justify-center gap-4 max-w-4xl w-full px-8"
    aria-label="Date navigation"
  >
    {
      prev ? (
        <a
          href={`/${prev}`}
          class="text-red border-2 border-red rounded-[3px] px-3 py-1 text-base hover:bg-red hover:text-paper transition-colors duration-150"
        >
          ← {prev}
        </a>
      ) : (
        <span class="w-[128px]" />
      )
    }
    <a
      href="/calendar"
      class="text-ink border-2 border-ink rounded-[3px] px-3 py-1 text-base hover:bg-ink hover:text-paper transition-colors duration-150"
    >
      Naptár
    </a>
    {
      next ? (
        <a
          href={`/${next}`}
          class="text-pen border-2 border-pen rounded-[3px] px-3 py-1 text-base hover:bg-pen hover:text-paper transition-colors duration-150"
        >
          {next} →
        </a>
      ) : (
        <span class="w-[128px]" />
      )
    }
  </nav>
</Layout>
