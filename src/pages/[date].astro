---
import Layout from "../layouts/Layout.astro";
import NewsEntry from "../components/NewsEntry.astro";

export async function getStaticPaths() {
  const files = import.meta.glob("../../news/*.json", { eager: true });

  return Object.entries(files)
    .map(([path, data]) => {
      const date = path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1];
      if (!date) return null;
      return { params: { date }, props: { data } };
    })
    .filter(Boolean);
}

const { data } = Astro.props as { data: any };
const { date } = Astro.params;

const allFiles = import.meta.glob("../../news/*.json", { eager: true });
const allDates = Object.keys(allFiles)
  .map((p) => p.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1])
  .filter(Boolean)
  .sort() as string[];

const idx = allDates.indexOf(date!);
const prev = idx > 0 ? allDates[idx - 1] : null;
const next = idx < allDates.length - 1 ? allDates[idx + 1] : null;

const siteUrl = "https://hirek.hangnem.cc";
const pageUrl = `${siteUrl}/${date}`;
const [y, m, d] = date!.split("-");
const dateLabel = new globalThis.Date(Number(y), Number(m) - 1, Number(d)).toLocaleDateString("hu-HU", { year: "numeric", month: "long", day: "numeric" });
const description = `Napi hírösszefoglaló ${dateLabel} — világ és Magyarország.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": `Hírnapló – ${dateLabel}`,
  "description": description,
  "datePublished": date,
  "inLanguage": "hu",
  "url": pageUrl,
  "publisher": {
    "@type": "Organization",
    "name": "Hírnapló",
    "url": siteUrl,
  },
};
---

<Layout title={date} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd}>
  <NewsEntry data={data} />

  <nav
    class="font-hand mt-8 flex flex-row flex-wrap items-center justify-center gap-3 max-w-4xl w-full px-4 md:px-8 pb-8"
    aria-label="Date navigation"
  >
    {
      prev ? (
        <a
          href={`/${prev}`}
          class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity duration-150"
        >
          <img
            src="/images/arrow_red_sm.webp"
            alt="←"
            class="h-10 w-auto scale-x-[-1]"
          />
          <span class="hidden sm:inline text-red text-base">{prev}</span>
        </a>
      ) : (
        <span class="w-11 sm:w-[128px]" />
      )
    }
    <a
      href="/calendar"
      class="text-ink border-2 border-ink rounded-[3px] px-3 py-1 text-base hover:bg-ink hover:text-paper transition-colors duration-150"
    >
      Naptár
    </a>
    {
      next ? (
        <a
          href={`/${next}`}
          class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity duration-150"
        >
          <span class="hidden sm:inline text-pen text-base">{next}</span>
          <img src="/images/arrow_blue_sm.webp" alt="→" class="h-10 w-auto" />
        </a>
      ) : (
        <a
          href="/today"
          class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity duration-150"
        >
          <span class="hidden sm:inline text-pen text-base">Ma</span>
          <img src="/images/arrow_blue_sm.webp" alt="→" class="h-10 w-auto" />
        </a>
      )
    }
  </nav>
</Layout>
