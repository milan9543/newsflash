---
import Layout from "../layouts/Layout.astro";
import NewsEntry from "../components/NewsEntry.astro";

// Load all news JSON files at build time
const files = import.meta.glob("../../news/*.json", { eager: true });

// Sort by filename (ISO date) descending → most recent first
const entries = Object.entries(files)
  .map(([path, data]) => {
    const date = path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1];
    return { date, data: data as any };
  })
  .filter((e) => e.date)
  .sort((a, b) => b.date!.localeCompare(a.date!));

const latest = entries[0] ?? null;
---

<Layout title="Tegnap" description="A legfrissebb hírösszefoglaló.">
  {
    latest ? (
      <>
        <NewsEntry data={latest.data} />
      </>
    ) : (
      <div class="empty">
        <p class="empty-title">Még nincs bejegyzés.</p>
        <p class="empty-sub">
          Az első összefoglaló éjfél után jelenik meg.
        </p>
      </div>
    )
  }
</Layout>

<style>
  .label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }

  .empty {
    padding: 3rem 0;
    text-align: center;
  }

  .empty-title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .empty-sub {
    font-family: "Patrick Hand", cursive;
    color: var(--ink-soft);
    font-size: 1rem;
  }
</style>
