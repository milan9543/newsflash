---
import Layout from "../layouts/Layout.astro";

const files = import.meta.glob("../../news/*.json", { eager: true });

const articleDates = new Set(
  Object.keys(files)
    .map((path) => path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1])
    .filter(Boolean) as string[],
);

const allDates = [...articleDates].sort();
const earliest = allDates[0];
const latest = allDates[allDates.length - 1];

const months: { year: number; month: number; key: string }[] = [];
if (earliest && latest) {
  const [ey, em] = earliest.split("-").map(Number) as [number, number];
  const [ly, lm] = latest.split("-").map(Number) as [number, number];
  let y = ey,
    m = em;
  while (y < ly || (y === ly && m <= lm)) {
    months.push({
      year: y,
      month: m,
      key: `${y}-${String(m).padStart(2, "0")}`,
    });
    m++;
    if (m > 12) {
      m = 1;
      y++;
    }
  }
}
months.reverse();

const DAY_NAMES = ["H", "K", "Sze", "Cs", "P", "Szo", "V"];

function monthLabel(y: number, m: number) {
  return new Date(y, m - 1, 1).toLocaleDateString("hu-HU", {
    month: "long",
    year: "numeric",
  });
}

function buildGrid(y: number, m: number): (number | null)[][] {
  const firstDay = new Date(y, m - 1, 1).getDay();
  const startOffset = (firstDay + 6) % 7;
  const daysInMonth = new Date(y, m, 0).getDate();
  const cells: (number | null)[] = [
    ...Array(startOffset).fill(null),
    ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
  ];
  while (cells.length % 7 !== 0) cells.push(null);
  const rows: (number | null)[][] = [];
  for (let i = 0; i < cells.length; i += 7) rows.push(cells.slice(i, i + 7));
  return rows;
}

function pad(n: number) {
  return String(n).padStart(2, "0");
}

const monthKeys = months.map((m) => m.key);
const monthLabels = months.map(({ year, month }) => monthLabel(year, month));
---

<Layout title="Naptár" description="Összes hírösszefoglaló böngészése.">
  <div
    class="font-hand flex flex-col items-center gap-6 py-10 w-full max-w-sm px-4"
  >
    <h1 class="text-4xl font-thin text-ink">Naptár</h1>

    <!-- Month navigation -->
    <div class="flex flex-row items-center justify-between w-full gap-2">
      <button
        id="prev-month"
        class="text-red border-2 border-red rounded-[3px] px-3 py-1 text-base hover:bg-red hover:text-paper transition-colors duration-150 disabled:opacity-30 disabled:pointer-events-none"
        >←</button
      >
      <span
        id="month-label"
        class="text-xl text-pen border-2 border-pen rounded-[3px] px-2 py-1 flex-1 text-center"
      ></span>
      <button
        id="next-month"
        class="text-pen border-2 border-pen rounded-[3px] px-3 py-1 text-base hover:bg-pen hover:text-paper transition-colors duration-150 disabled:opacity-30 disabled:pointer-events-none"
        >→</button
      >
    </div>

    <!-- Calendar grids (one per month, hidden/shown by JS) -->
    {
      months.map(({ year, month, key }) => {
        const grid = buildGrid(year, month);
        return (
          <div class="cal-month w-full hidden" data-month={key}>
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  {DAY_NAMES.map((d) => (
                    <th class="text-center text-sm text-ink-soft font-normal pb-2 w-[14.28%]">
                      {d}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {grid.map((row) => (
                  <tr>
                    {row.map((day) => {
                      if (!day) return <td class="p-1 text-center" />;
                      const iso = `${year}-${pad(month)}-${pad(day)}`;
                      const hasArticle = articleDates.has(iso);
                      return (
                        <td class="p-1 text-center">
                          {hasArticle ? (
                            <a
                              href={`/${iso}`}
                              data-date={iso}
                              class="cal-day-article relative inline-flex flex-col items-center justify-center w-9 h-9 border-2 border-red rounded-[3px] text-red hover:bg-red hover:text-paper transition-colors duration-150 leading-none"
                            >
                              <span class="text-base">{day}</span>
                              <span class="absolute bottom-[3px] w-1 h-1 rounded-full bg-current" />
                            </a>
                          ) : (
                            <span
                              data-date={iso}
                              class="cal-day inline-flex items-center justify-center w-9 h-9 text-ink-soft text-base opacity-40"
                            >
                              {day}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      })
    }
  </div>
</Layout>

<script is:inline define:vars={{ monthKeys, monthLabels }}>
  const today = new Date();
  const todayISO = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
  const todayMonth = todayISO.slice(0, 7);

  const params = new URLSearchParams(location.search);
  let activeKey = params.get("month") || todayMonth;
  if (!monthKeys.includes(activeKey)) activeKey = monthKeys[0];

  const labelEl = document.getElementById("month-label");
  const prevBtn = document.getElementById("prev-month");
  const nextBtn = document.getElementById("next-month");

  function show(key) {
    document
      .querySelectorAll(".cal-month")
      .forEach((el) => el.classList.add("hidden"));
    const active = document.querySelector(`.cal-month[data-month="${key}"]`);
    if (active) active.classList.remove("hidden");

    const idx = monthKeys.indexOf(key);
    labelEl.textContent = monthLabels[idx];
    prevBtn.disabled = idx >= monthKeys.length - 1;
    nextBtn.disabled = idx <= 0;

    // Highlight today
    document.querySelectorAll("[data-date]").forEach((el) => {
      el.classList.remove("!border-ink", "!text-ink", "ring-2", "ring-ink");
    });
    const todayEl = active?.querySelector(`[data-date="${todayISO}"]`);
    if (todayEl) {
      todayEl.classList.add(
        "bg-ink",
        "!text-paper",
        "!opacity-100",
        "!border-ink",
        "rounded-[3px]",
      );
    }

    history.replaceState(null, "", `?month=${key}`);
  }

  prevBtn.addEventListener("click", () => {
    const idx = monthKeys.indexOf(activeKey);
    if (idx < monthKeys.length - 1) {
      activeKey = monthKeys[idx + 1];
      show(activeKey);
    }
  });

  nextBtn.addEventListener("click", () => {
    const idx = monthKeys.indexOf(activeKey);
    if (idx > 0) {
      activeKey = monthKeys[idx - 1];
      show(activeKey);
    }
  });

  show(activeKey);
</script>
