---
// @ts-nocheck
const files = import.meta.glob("../../news/*.json", { eager: true });

const latestDate = Object.keys(files)
  .map((path) => path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1])
  .filter(Boolean)
  .sort((a, b) => b.localeCompare(a))[0];

return Astro.redirect(latestDate ? `/${latestDate}` : '/calendar', 301);
---
