---
export interface NewsUrl {
  name: string;
  url: string;
}

export interface NewsItem {
  keyword: string;
  title: string;
  short_title?: string;
  urls: NewsUrl[];
}

export interface DayData {
  date: string;
  world: NewsItem[];
  hungary: NewsItem[];
}

export interface Props {
  data: DayData;
  linkDate?: boolean;
}

const { data } = Astro.props;

const OUTLET_COLORS: Record<string, { bg: string; fg: string }> = {
  BBC: { bg: "#000", fg: "#fff" },
  AP: { bg: "#FE332F", fg: "#fff" },
  Reuters: { bg: "#D64000", fg: "#fff" },
  "Al Jazeera": { bg: "#FA9001", fg: "#fff" },
  Telex: { bg: "#113356", fg: "#fff" },
  "444": { bg: "#FFF671", fg: "#1B1B1B" },
  HVG: { bg: "#F26522", fg: "#fff" },
  "24.hu": { bg: "#FB4743", fg: "#fff" },
};

function outletStyle(name: string) {
  const c = OUTLET_COLORS[name];
  return c ? `--chip-color:${c.bg};--chip-fg:${c.fg}` : "";
}
---

<article
  class="font-hand max-w-4xl flex flex-col justify-center items-center p-2 md:p-8 gap-4 w-full"
>
  <div class="text-4xl font-thin text-center text-ink">Hírnapló</div>
  <div
    class="text-xl text-center text-pen border-2 border-pen rounded-[3px] px-2 mb-4"
  >
    {new Date(data.date).toLocaleDateString("hu-HU")}
  </div>

  <div class="flex flex-col md:flex-row gap-2 w-full">
    <!-- ── Sections ── -->
    {
      data.hungary?.length > 0 && (
        <section class="text-red flex flex-col items-start mb-4 flex-1 p-2 md:p-4">
          <h2 class="underline uppercase mb-4 text-2xl text-center w-full">
            Magyarország
          </h2>
          <ul class="flex flex-col gap-4">
            {data.hungary.map((item, index) => (
              <li class="flex flex-row gap-2 font-bold items-start justify-start">
                <div class="flex flex-row gap-2 items-center">
                  <div class="border-2 border-red size-8 aspect-square rounded-full flex items-center justify-center">
                    {index + 1}.
                  </div>
                </div>
                <div class="">
                  <span>
                    <p class="text-lg">{item.keyword}</p>

                    <p class="text-ink text-lg">
                      {item.short_title ?? item.title}
                    </p>
                    <div class="flex flex-row flex-wrap gap-2">
                      {item.urls?.map((u) => (
                        <a
                          style={outletStyle(u.name)}
                          href={u.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-ink underline decoration-red hover:decoration-pen opacity-50 hover:opacity-100 transition-opacity duration-150"
                        >
                          {u.name}
                        </a>
                      ))}
                    </div>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <div class="md:w-[2px] md:self-stretch h-[2px] w-full bg-ink rounded-sm">
    </div>
    {
      data.world?.length > 0 && (
        <section class="text-pen flex flex-col items-start mb-4 flex-1 p-2 md:p-4">
          <h2 class="underline uppercase mb-4 text-2xl text-center w-full">
            Világ
          </h2>
          <ul class="flex flex-col gap-4">
            {data.world.map((item, index) => (
              <li class="flex flex-row gap-2 font-bold items-start justify-start">
                <div class="flex flex-row gap-2 items-center">
                  <div class="border-2 border-pen size-8 aspect-square rounded-full flex items-center justify-center">
                    {index + 1}.
                  </div>
                </div>
                <div class="">
                  <span>
                    <p class="text-lg">{item.keyword}</p>
                    <p class="text-ink text-lg">
                      {item.short_title ?? item.title}
                    </p>
                    <div class="flex flex-row flex-wrap gap-2">
                      {item.urls?.map((u) => (
                        <a
                          style={outletStyle(u.name)}
                          href={u.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-ink underline decoration-pen hover:decoration-red opacity-50 hover:opacity-100 transition-opacity duration-150"
                        >
                          {u.name}
                        </a>
                      ))}
                    </div>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</article>
