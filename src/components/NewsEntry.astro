---
export interface NewsItem {
  keyword: string;
  title: string;
  short_title?: string;
  url: string;
}

export interface DayData {
  date: string;
  world: NewsItem[];
  hungary: NewsItem[];
}

export interface Props {
  data: DayData;
  linkDate?: boolean;
}

const { data, linkDate = false } = Astro.props;

function parseParts(iso: string) {
  const [y, m, d] = iso.split("-").map(Number);
  const dt = new Date(y, m - 1, d);
  const dayNum = String(d).padStart(2, "0");
  const weekday = dt.toLocaleDateString("hu-HU", { weekday: "long" });
  const monthName = dt.toLocaleDateString("hu-HU", { month: "long" });

  // ISO week number
  const tmp = new Date(dt.getTime());
  tmp.setHours(0, 0, 0, 0);
  tmp.setDate(tmp.getDate() + 3 - ((tmp.getDay() + 6) % 7));
  const week1 = new Date(tmp.getFullYear(), 0, 4);
  const weekNum =
    1 +
    Math.round(
      ((tmp.getTime() - week1.getTime()) / 86400000 -
        3 +
        ((week1.getDay() + 6) % 7)) /
        7,
    );

  return { dayNum, weekday, monthName, year: y, weekNum };
}

const parts = parseParts(data.date);
---

<article class="day-entry">
  <!-- ── Big date stamp ── -->
  <div class="date-stamp">
    <div class="date-stamp-left">
      {
        linkDate ? (
          <a class="date-num" href={`/${data.date}`}>
            {parts.dayNum}
          </a>
        ) : (
          <span class="date-num">{parts.dayNum}</span>
        )
      }
    </div>
    <div class="date-stamp-right">
      <span class="date-weekday">{parts.weekday}</span>
      <span class="date-month">{parts.monthName} {parts.year}</span>
      <span class="date-week">hét / <strong>{parts.weekNum}</strong></span>
      <nav class="stamp-nav">
        <a href="/yesterday">Tegnap</a>
        <a href="/calendar">Naptár</a>
      </nav>
    </div>
  </div>

  <!-- ── Sections ── -->
  {
    data.hungary?.length > 0 && (
      <section class="section">
        <h2 class="section-heading">Magyarország</h2>
        <ul class="news-list">
          {data.hungary.map((item) => (
            <li class="news-item">
              <span class="keyword">{item.keyword}</span>
              <a
                class="news-link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.short_title ?? item.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    data.world?.length > 0 && (
      <section class="section">
        <h2 class="section-heading">Világ</h2>
        <ul class="news-list">
          {data.world.map((item) => (
            <li class="news-item">
              <span class="keyword">{item.keyword}</span>
              <a
                class="news-link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.short_title ?? item.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

<style>
  .day-entry {
  }

  /* ── Date stamp ──────────────────────────────────── */
  .date-stamp {
    display: inline-flex;
    align-items: flex-start;
    margin-left: 1px;
    gap: 1rem;
    padding: var(--line-h) 0.5rem 0;
    margin-bottom: var(--line-h);
    background: var(--paper);
  }

  .date-num {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    /* exactly 4 lines tall: 4 × 1.75rem = 7rem */
    font-size: 8.75rem;
    font-weight: 900;
    line-height: calc(var(--line-h) * 5);
    color: var(--ink);
    text-decoration: none;
    display: block;
    position: relative;
  }

  .date-num::after {
    content: "";
    /* absolutely positioned so it adds zero height to the layout */
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--red);
  }

  .date-num:hover {
    color: var(--red);
  }

  .date-stamp-right {
    display: flex;
    flex-direction: column;
    /* weekday=2 + month=1 + week=0.5 + nav=0.5 = 4 lines */
    justify-content: flex-start;
    height: calc(var(--line-h) * 4);
    gap: 0;
  }

  .date-weekday {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 1.75rem;
    font-weight: 900;
    /* 2 lines */
    line-height: calc(var(--line-h) * 2);
    color: var(--ink);
  }

  .date-month {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 900;
    color: var(--ink-soft);
    line-height: var(--line-h);
    margin-bottom: 0;
  }

  .date-week {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    padding: 0;
    width: fit-content;
    line-height: calc(var(--line-h));
    height: calc(var(--line-h));
    display: flex;
    align-items: center;
  }

  .stamp-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    line-height: calc(var(--line-h));
    height: calc(var(--line-h));
  }

  .stamp-nav a {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 1rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color 0.12s,
      border-color 0.12s;
    border-bottom: 1px solid var(--red);
  }

  .stamp-nav a:hover {
    color: var(--red);
  }

  /* ── Sections ────────────────────────────────────── */
  .section {
    padding-left: 1rem;
    /* 2 lines between sections */
    margin-bottom: calc(var(--line-h) * 2);
  }

  .section-heading {
    font-family: "Patrick Hand", cursive;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink-soft);
    /* exactly 1 line tall */
    line-height: var(--line-h);
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── News list ───────────────────────────────────── */
  .news-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .news-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem;
    align-items: start;
  }

  .keyword {
    font-family: "Patrick Hand", cursive;
    font-size: 0.8rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--paper);
    background: var(--pen);
    padding: 0 0.45em;
    border-radius: 2px;
    white-space: nowrap;
    line-height: calc(var(--line-h) * 0.6);
    margin-top: calc(var(--line-h) * 0.2);
    margin-bottom: calc(var(--line-h) * 0.2);
    transition: background 0.15s;
  }

  .news-item:hover .keyword {
    background: var(--ink);
  }

  .news-link {
    font-family: "Patrick Hand", cursive;
    font-size: 1.1rem;
    line-height: var(--line-h);
    color: var(--pen);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .news-link:hover {
    color: var(--red);
    border-color: var(--red);
  }

  @media (max-width: 600px) {
    .date-stamp {
      padding-top: var(--line-h);
      padding-left: 0;
    }

    .date-num {
      /* 4 lines on mobile */
      font-size: 7rem;
      line-height: calc(var(--line-h) * 4);
    }

    .date-stamp-right {
      /* weekday=1 + month=1 + week=0.5 + nav=0.5 = 3 lines */
      height: calc(var(--line-h) * 3);
    }

    .date-weekday {
      font-size: 1.4rem;
      line-height: var(--line-h);
    }

    .date-month {
      line-height: var(--line-h);
      margin-bottom: 0;
    }

    .section {
      padding-left: 0;
      margin-bottom: calc(var(--line-h) * 1);
    }

    .news-item {
      display: block;
    }
    .news-link {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }

    .keyword {
      display: block;
      width: fit-content;
      /* full line, no fractional margins */
      line-height: var(--line-h);
      margin-top: 0;
      margin-bottom: 0;
    }

    .news-link {
      display: block;
      line-height: var(--line-h);
    }
  }
</style>
