---
export interface NewsUrl {
  name: string;
  url: string;
}

export interface NewsItem {
  keyword: string;
  title: string;
  short_title?: string;
  urls: NewsUrl[];
}

export interface DayData {
  date: string;
  world: NewsItem[];
  hungary: NewsItem[];
}

export interface Props {
  data: DayData;
  linkDate?: boolean;
}

const { data } = Astro.props;

const OUTLET_COLORS: Record<string, { bg: string; fg: string }> = {
  BBC: { bg: "#000", fg: "#fff" },
  AP: { bg: "#FE332F", fg: "#fff" },
  Reuters: { bg: "#D64000", fg: "#fff" },
  "Al Jazeera": { bg: "#FA9001", fg: "#fff" },
  Telex: { bg: "#113356", fg: "#fff" },
  "444": { bg: "#FFF671", fg: "#1B1B1B" },
  HVG: { bg: "#F26522", fg: "#fff" },
  "24.hu": { bg: "#FB4743", fg: "#fff" },
};

function outletStyle(name: string) {
  const c = OUTLET_COLORS[name];
  return c ? `--chip-color:${c.bg};--chip-fg:${c.fg}` : "";
}
---

<article
  class="font-hand max-w-7xl flex flex-col justify-center items-center p-2 md:p-8 gap-4 w-full"
>
<div class="relative flex items-center justify-center mb-4">
    <img src="/images/ribbon.webp" alt="" class="h-20 w-auto" />
    <span
      class="mb-1 absolute inset-0 flex items-center justify-center text-lg text-ink font-bold"
    >
      {new Date(data.date).toLocaleDateString("hu-HU")}
    </span>
  </div>

  <div class="flex flex-col md:flex-row md:items-stretch gap-2 w-full">
    <!-- ── Sections ── -->
    {
      data.hungary?.length > 0 && (
        <section class="text-red flex flex-col items-start mb-4 flex-1 p-2 md:p-4">
          <h2 class="underline uppercase mb-8 text-2xl text-center w-full">
            <span class="relative inline-block underline">
              <img
                src="/images/flag_hu.webp"
                alt="HU"
                class="absolute right-full top-1/2 -translate-y-1/2 mr-2 h-10 w-auto"
              />
              Magyarország
            </span>
          </h2>
          <ul class="flex flex-col gap-4">
            {data.hungary.map((item, index) => (
              <li class="flex flex-row gap-2 font-bold items-start justify-start">
                <div class="flex flex-row gap-2 items-center">
                  <div class="relative size-12">
                    <img
                      src={`/images/circle_red/red_${index + 1}.webp`}
                      alt=""
                      class="absolute inset-0 size-12"
                    />
                    <span class="absolute inset-0 flex items-center justify-center text-red text-md font-bold">
                      {index + 1}
                    </span>
                  </div>
                </div>
                <div class="pt-2">
                  <span>
                    <p class="text-lg">{item.keyword}</p>

                    <p class="text-ink text-lg">
                      {item.short_title ?? item.title}
                    </p>
                    <div class="flex flex-row flex-wrap gap-2">
                      {item.urls?.map((u) => (
                        <a
                          style={outletStyle(u.name)}
                          href={u.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-ink underline decoration-red hover:decoration-pen opacity-50 hover:opacity-100 transition-opacity duration-150"
                        >
                          {u.name}
                        </a>
                      ))}
                    </div>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <div class="hidden md:flex md:items-stretch px-2">
      <div class="w-[2px] self-stretch bg-ink rounded-sm"></div>
    </div>
    <div class="md:hidden py-4">
      <div class="h-[2px] w-full bg-ink rounded-sm"></div>
    </div>
    {
      data.world?.length > 0 && (
        <section class="text-pen flex flex-col items-start mb-4 flex-1 p-2 md:p-4">
          <h2 class="underline uppercase mb-8 text-2xl text-center w-full">
            <span class="relative inline-block underline">
              <img
                src="/images/earth.webp"
                alt=""
                class="absolute right-full top-1/2 -translate-y-1/2 mr-2 h-10 w-auto"
              />
              World
            </span>
          </h2>
          <ul class="flex flex-col gap-4">
            {data.world.map((item, index) => (
              <li class="flex flex-row gap-2 font-bold items-start justify-start">
                <div class="flex flex-row gap-2 items-center">
                  <div class="relative size-12">
                    <img
                      src={`/images/circle_blue/blue_${index + 1}.webp`}
                      alt=""
                      class="absolute inset-0 size-12"
                    />
                    <span class="absolute inset-0 flex items-center justify-center text-pen text-md font-bold">
                      {index + 1}
                    </span>
                  </div>
                </div>
                <div class="pt-2">
                  <span>
                    <p class="text-lg">{item.keyword}</p>
                    <p class="text-ink text-lg">
                      {item.short_title ?? item.title}
                    </p>
                    <div class="flex flex-row flex-wrap gap-2">
                      {item.urls?.map((u) => (
                        <a
                          style={outletStyle(u.name)}
                          href={u.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-ink underline decoration-pen hover:decoration-red opacity-50 hover:opacity-100 transition-opacity duration-150"
                        >
                          {u.name}
                        </a>
                      ))}
                    </div>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</article>
